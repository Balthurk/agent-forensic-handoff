{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Balthurk/agent-forensic-handoff/specification/contracts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program", "error_catalog", "profiles", "sources", "recommendations", "changes", "requirements", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "program": {"type":"object","required":["id","target_version","baseline_commit","baseline_version","openspec_version","protocol_version","status","generated_views"],"additionalProperties":false,"properties":{"id":{"const":"afh-v0.4.0"},"target_version":{"const":"0.4.0"},"baseline_commit":{"$ref":"#/$defs/digest40"},"baseline_version":{"type":"string"},"openspec_version":{"const":"1.12.0"},"protocol_version":{"const":"4.0"},"status":{"enum":["DRAFT","READY_FOR_COORDINATOR_REVIEW"]},"generated_views":{"type":"array","items":{"type":"string"},"minItems":3,"uniqueItems":true}}},
    "error_catalog":{"type":"array","minItems":1,"items":{"type":"object","required":["code","status","exit","retryable","effect","recovery"],"additionalProperties":false,"properties":{"code":{"$ref":"#/$defs/string"},"status":{"enum":["ERROR","UNAVAILABLE","PARTIAL","INCONCLUSIVE_COVERAGE"]},"exit":{"type":"integer","minimum":1,"maximum":8},"retryable":{"type":"boolean"},"effect":{"enum":["NONE","STAGING_ONLY","COMMITTED_WITH_GAPS"]},"recovery":{"$ref":"#/$defs/string"}}}},
    "profiles":{"type":"array","minItems":1,"items":{"type":"object","required":["id","extends","contract_refs","invariants","required_checks"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/string"},"extends":{"$ref":"#/$defs/strings"},"contract_refs":{"$ref":"#/$defs/nonemptyStrings"},"invariants":{"$ref":"#/$defs/nonemptyStrings"},"required_checks":{"$ref":"#/$defs/nonemptyStrings"}}}},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["id","kind","description","ref"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/string"},"kind":{"enum":["CURRENT_BRIEF","HISTORICAL_RECOMMENDATION","NEW_INFERENCE","APPROVED_DIAGNOSIS","OBSERVED_BASELINE"]},"description":{"$ref":"#/$defs/string"},"ref":{"$ref":"#/$defs/string"}}}},
    "recommendations":{"type":"array","minItems":22,"maxItems":22,"items":{"type":"object","required":["id","title","origin","decision","rationale","requirement_ids"],"additionalProperties":false,"properties":{"id":{"pattern":"^(H0[1-6]|Q(0[1-9]|1[0-5])|N01)$","type":"string"},"title":{"$ref":"#/$defs/string"},"origin":{"enum":["HISTORICAL","NEW_INFERENCE"]},"decision":{"enum":["CONSERVAR_PROBAR","IMPLEMENTAR","INTEGRAR","SUSTITUIR"]},"rationale":{"$ref":"#/$defs/string"},"requirement_ids":{"$ref":"#/$defs/nonemptyStrings"}}}},
    "changes":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/change"}},
    "requirements":{"type":"array","minItems":70,"items":{"type":"object","required":["id","change_id","title","statement","source_refs","scenario_ids"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^AFH-[0-9]{2}-R[0-9]{2}$"},"change_id":{"$ref":"#/$defs/string"},"title":{"$ref":"#/$defs/string"},"statement":{"$ref":"#/$defs/string"},"source_refs":{"$ref":"#/$defs/nonemptyStrings"},"scenario_ids":{"$ref":"#/$defs/nonemptyStrings"}}}},
    "scenarios":{"type":"array","minItems":200,"items":{"$ref":"#/$defs/scenario"}}
  },
  "$defs": {
    "string":{"type":"string","minLength":1},
    "strings":{"type":"array","items":{"$ref":"#/$defs/string"},"uniqueItems":true},
    "nonemptyStrings":{"type":"array","items":{"$ref":"#/$defs/string"},"minItems":1,"uniqueItems":true},
    "digest40":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "digest64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "fileRef":{"type":"object","required":["path","pointer","sha256"],"additionalProperties":false,"properties":{"path":{"$ref":"#/$defs/string"},"pointer":{"type":"string"},"sha256":{"$ref":"#/$defs/digest64"}}},
    "change":{"type":"object","required":["id","order","capability","purpose","problem","benefit","profiles","depends_on","write_set","interfaces","design","entry_criteria","exit_criteria"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^afh-[0-9]{2}-[a-z0-9-]+$"},"order":{"type":"integer","minimum":1,"maximum":14},"capability":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},"purpose":{"type":"string","minLength":50},"problem":{"$ref":"#/$defs/string"},"benefit":{"$ref":"#/$defs/string"},"profiles":{"$ref":"#/$defs/nonemptyStrings"},"depends_on":{"$ref":"#/$defs/strings"},"write_set":{"$ref":"#/$defs/nonemptyStrings"},"interfaces":{"$ref":"#/$defs/nonemptyStrings"},"design":{"type":"object","required":["algorithm","rationale","alternatives","persistence","compatibility","recovery","integration","risks"],"additionalProperties":false,"properties":{"algorithm":{"$ref":"#/$defs/string"},"rationale":{"$ref":"#/$defs/string"},"alternatives":{"$ref":"#/$defs/string"},"persistence":{"$ref":"#/$defs/string"},"compatibility":{"$ref":"#/$defs/string"},"recovery":{"$ref":"#/$defs/string"},"integration":{"$ref":"#/$defs/string"},"risks":{"$ref":"#/$defs/string"}}},"entry_criteria":{"$ref":"#/$defs/nonemptyStrings"},"exit_criteria":{"$ref":"#/$defs/nonemptyStrings"}}},
    "scenario":{"type":"object","required":["id","change_id","title","requirement_ids","source_ref","contract_refs","preconditions","given","when","then","fixture_ref","entrypoint","oracle_ref","evidence_kind","phase","required_checks","paired_with"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^AFH-[0-9]{2}-T[0-9]{2}$"},"change_id":{"$ref":"#/$defs/string"},"title":{"$ref":"#/$defs/string"},"requirement_ids":{"$ref":"#/$defs/nonemptyStrings"},"source_ref":{"$ref":"#/$defs/string"},"contract_refs":{"$ref":"#/$defs/nonemptyStrings"},"preconditions":{"$ref":"#/$defs/nonemptyStrings"},"given":{"$ref":"#/$defs/string"},"when":{"$ref":"#/$defs/string"},"then":{"$ref":"#/$defs/string"},"fixture_ref":{"$ref":"#/$defs/fileRef"},"oracle_ref":{"$ref":"#/$defs/fileRef"},"entrypoint":{"type":"object","required":["kind","command","args","cwd","availability"],"additionalProperties":false,"properties":{"kind":{"enum":["CLI","API","CONTROLLED_EXPERIMENT","PACKAGE_TEST"]},"command":{"$ref":"#/$defs/string"},"args":{"type":"array","items":{"type":"string"},"minItems":1},"cwd":{"const":"$CHECKOUT"},"availability":{"enum":["EXECUTABLE","CONTRACT_ONLY"]}}},"evidence_kind":{"enum":["SYNTHETIC_REAL_RUNTIME","SYNTHETIC_REAL_MODEL","SYNTHETIC_FIXTURE_PROVIDER","REAL_PROCESS_CRASH","PLATFORM_RUNTIME","BLIND_AGENT_CONTINUATION","PACKAGE_VALIDATION","RELEASE_ARTIFACT"]},"phase":{"enum":["BASELINE","OBSERVED_RED","IMPLEMENTATION_CONTRACT","SPECIFICATION_TEST"]},"required_checks":{"$ref":"#/$defs/nonemptyStrings"},"paired_with":{"$ref":"#/$defs/strings"}}}
  }
}
