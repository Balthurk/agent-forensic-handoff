{
  "name": "copilot-events",
  "critical": {
    "eventKinds": [
      "session.meta", "session.settings", "session.turn_started", "session.turn_ended", "session.aborted", "session.resumed",
      "session.shutdown", "session.warning", "session.error", "session.compaction_started", "session.compacted", "session.truncated",
      "session.context_changed", "session.notification", "session.binary_asset", "session.task_complete",
      "message.user", "message.agent", "message.instruction", "message.human_response", "reasoning.summary",
      "tool.requested", "tool.started", "tool.completed", "permission.requested", "permission.completed",
      "external.hook", "external.subagent", "external.tool_dispatch",
      "telemetry.token_usage", "telemetry.usage_checkpoint", "telemetry.auxiliary_model", "forensic.unparsed_record"
    ],
    "actorKinds": ["HUMAN_USER", "PRIMARY_AGENT", "SUBAGENT", "TOOL", "MCP_SERVER", "HOOK", "HARNESS_SYSTEM", "EXTERNAL_SERVICE"],
