    "externalMinimum": 1,
    "unparsed": 1,
    "warnings": 4,
    "validationsMinimum": 3,
    "hotTerms": ["fix the parser", "run the build too", "12 passing", "npm run lint", "INTERRUPTED", "APPROVAL_DENIED"],
    "timelinePairs": [
      ["session.meta", "message.user"], ["message.user", "tool.requested"], ["tool.requested", "tool.started"],
      ["tool.started", "permission.requested"], ["permission.requested", "permission.completed"], ["permission.completed", "tool.completed"],
      ["session.aborted", "session.resumed"]
    ]
